---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { GA_ID, GA_ENABLED } from '../lib/analytics';

const gtagSrc = GA_ENABLED
  ? `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`
  : 'https://www.googletagmanager.com/gtag/js';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Oropis covers artificial intelligence and robotics with original reporting: frontier models, research, humanoids, autonomy, policy, and the business of the machine economy.',
  image = '/og-default.png',
  type = 'website',
  published,
  updated,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = 'Oropis';
const fullTitle = title ? `${title} — Oropis` : `${siteName} — Robotics & AI, reported`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/news/', label: 'Latest' },
  { href: '/ai/', label: 'AI' },
  { href: '/robotics/', label: 'Robotics' },
  { href: '/research/', label: 'Research' },
  { href: '/industry/', label: 'Industry' },
  { href: '/beats/', label: 'Beats' },
];

const isActive = (href: string) => current === href.replace(/\/+$/, '') || current.startsWith(href.replace(/\/+$/, '') + '/');

const structured = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" id="theme-color-meta" />
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem('oropis-theme');
        } catch (e) {}
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.style.colorScheme = theme;
        var themeMeta = document.getElementById('theme-color-meta');
        if (themeMeta) themeMeta.setAttribute('content', theme === 'dark' ? '#0d0f12' : '#ffffff');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />

    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4197092338559183"
      crossorigin="anonymous"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
      try {
        var storedConsent = localStorage.getItem('oropis-consent');
        if (storedConsent === 'granted') {
          gtag('consent', 'update', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted',
          });
        }
      } catch (e) {}
    </script>
    <script is:inline async src={gtagSrc}></script>
    {GA_ENABLED && (
      <script is:inline define:vars={{ GA_ID }}>
        gtag('config', GA_ID, { anonymize_ip: true });
      </script>
    )}

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OropisHQ" />
    <meta name="twitter:creator" content="@OropisHQ" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {structured.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/" aria-label="Oropis Robotics and AI home">
          <BrandMark />
          <span class="brand-text">
            <span class="brand-word">
              Oropis
              <svg class="brand-squiggle" viewBox="0 0 68 7" preserveAspectRatio="none" aria-hidden="true">
                <path d="M1.5 4.6C12 1.8 21 6 32 4.2 43 2.4 54 1.9 66.5 4.1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
              </svg>
            </span>
            <small>Robotics &amp; AI</small>
          </span>
        </a>

        <nav class="nav" aria-label="Sections">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
          ))}
        </nav>

        <div class="head-actions">
          <a class="search-link" href="/search/" aria-label="Search">Search</a>
          <ThemeToggle />
          <a class="x-link" href="https://x.com/OropisHQ" rel="me noopener" target="_blank" aria-label="OropisHQ on X">
            <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.5L6.2 22H3l7.3-8.4L2 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7.9 3.8H6.1L17.8 20Z"/></svg>
            <span>@OropisHQ</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href="/">
            <BrandMark />
            <span class="brand-text">
              <span class="brand-word">
                Oropis
                <svg class="brand-squiggle" viewBox="0 0 68 7" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M1.5 4.6C12 1.8 21 6 32 4.2 43 2.4 54 1.9 66.5 4.1" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"></path>
                </svg>
              </span>
              <small>Robotics &amp; AI</small>
            </span>
          </a>
          <p>Independent coverage of artificial intelligence and robotics: frontier models, research, humanoids, autonomy, policy, and the business of the machine economy.</p>
        </div>
        <div class="foot-col">
          <h2>Sections</h2>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="foot-col">
          <h2>Oropis</h2>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/corrections/">Corrections</a>
          <a href="/rss.xml">RSS feed</a>
        </div>
        <div class="foot-col">
          <h2>Legal</h2>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <button type="button" class="foot-link" id="cookie-settings">Cookie settings</button>
          <a href="https://x.com/OropisHQ" rel="me noopener" target="_blank">X / Twitter</a>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <span>&copy; {new Date().getFullYear()} Oropis</span>
        <span>Built for the people who want the signal.</span>
      </div>
    </footer>

    <ConsentBanner />

    <script is:inline>
      (function () {
        var button = document.getElementById('theme-toggle');
        if (!button) return;
        var media = window.matchMedia('(prefers-color-scheme: dark)');

        function current() {
          return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        }

        function sync() {
          var dark = current() === 'dark';
          button.setAttribute('aria-pressed', dark ? 'true' : 'false');
          button.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
        }

        function set(theme) {
          document.documentElement.setAttribute('data-theme', theme);
          document.documentElement.style.colorScheme = theme;
          var meta = document.getElementById('theme-color-meta');
          if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0f12' : '#ffffff');
          try {
            localStorage.setItem('oropis-theme', theme);
          } catch (e) {}
          sync();
        }

        button.addEventListener('click', function () {
          set(current() === 'dark' ? 'light' : 'dark');
        });

        if (typeof media.addEventListener === 'function') {
          media.addEventListener('change', function (event) {
            var stored = null;
            try {
              stored = localStorage.getItem('oropis-theme');
            } catch (e) {}
            if (stored === 'light' || stored === 'dark') return;
            var theme = event.matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', theme);
            document.documentElement.style.colorScheme = theme;
            var meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', theme === 'dark' ? '#0d0f12' : '#ffffff');
            sync();
          });
        }

        sync();
      })();
    </script>
  </body>
</html>
