---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  href?: string;
  linkLabel?: string;
}

const { eyebrow, title, description, href, linkLabel = 'See all' } = Astro.props;
---

<header class="section-head">
  <div>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2>
      {title}
      <svg class="section-squiggle" viewBox="0 0 66 9" preserveAspectRatio="none" aria-hidden="true">
        <path d="M1.5 5.6C12 2.4 21 7.2 32 5.2 43 3.2 54 2.4 64.5 5.1" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path>
      </svg>
    </h2>
    {description && <p class="section-description">{description}</p>}
  </div>
  {href && <a class="section-link" href={href}>{linkLabel} &rarr;</a>}
</header>
