---
import { fmtDate, formatArchetype, beatCode, beatSlug, storyUrl, type Story } from '../lib/news';

interface Props {
  story: Story;
  variant?: 'lead' | 'standard' | 'compact' | 'row';
}

const { story, variant = 'standard' } = Astro.props;
const { title, description, pubDate, beat, archetype, hero, heroCredit, tags } = story.data;
const url = storyUrl(story);
const label = formatArchetype(archetype);
const isRow = variant === 'row';
---

{isRow ? (
  <article class="story-card story-row">
    <a class="story-row-main" href={url}>
      <div class="story-row-copy">
        <div class="story-meta">
          <span class="story-beat">{beat}</span>
          <span aria-hidden="true">·</span>
          <span>{label}</span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
        </div>
        <h3 class="story-title">{title}</h3>
        <p class="story-dek">{description}</p>
      </div>
      {hero ? (
        <span class="story-thumb"><img src={hero} alt="" loading="lazy" /></span>
      ) : (
        <span class="story-thumb"><span class="story-thumb-fallback">{beatCode(beat)}</span></span>
      )}
      <span class="story-arrow" aria-hidden="true">
        <svg viewBox="0 0 20 10" fill="none">
          <path d="M1 5H7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
          <path d="M8.5 8.5 12 5 8.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          <path d="M13.5 8.5 17 5l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
      <span class="sr-only">Read more: {title}</span>
    </a>
  </article>
) : (
  <article class:list={['story-card', `story-${variant}`]}>
    <a class="story-image" href={url} tabindex="-1" aria-hidden="true">
      {hero ? (
        <img src={hero} alt="" loading={variant === 'lead' ? 'eager' : 'lazy'} />
      ) : (
        <span class="story-image-fallback"><span>{beatCode(beat)}</span></span>
      )}
      <span class="story-kicker">{label}</span>
    </a>

    <div class="story-body">
      <div class="story-meta">
        <a class="story-beat" href={`/beats/${beatSlug(beat)}/`}>{beat}</a>
        <span aria-hidden="true">·</span>
        <time datetime={pubDate.toISOString()}>{fmtDate(pubDate)}</time>
      </div>

      <h3 class="story-title"><a href={url}>{title}</a></h3>
      <p class="story-dek">{description}</p>

      {variant === 'lead' && (
        <a class="story-more" href={url}>
          Read the story
          <svg viewBox="0 0 20 10" fill="none" aria-hidden="true">
            <path d="M1 5H7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path>
            <path d="M8.5 8.5 12 5 8.5 1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
            <path d="M13.5 8.5 17 5l-3.5-3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      )}

      {tags.length > 0 && (
        <ul class="tag-row" aria-label="Tags">
          {tags.slice(0, 3).map((tag) => (
            <li><a href={`/tags/${tag.toLowerCase().replace(/[^a-z0-9]+/g, '-')}/`}>#{tag}</a></li>
          ))}
        </ul>
      )}

      {hero && heroCredit && <p class="credit">Image: {heroCredit}</p>}
    </div>
  </article>
)}
