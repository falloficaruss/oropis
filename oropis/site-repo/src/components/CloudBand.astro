---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['cloud-band', className]} aria-hidden="true">
  <svg class="cloud-back" viewBox="0 0 1440 200" preserveAspectRatio="none">
    <path d="M0 128C90 92 170 96 250 120C330 144 410 152 490 128C570 104 640 68 740 84C840 100 900 142 1000 138C1100 134 1180 92 1270 100C1350 108 1400 122 1440 130V200H0Z"></path>
  </svg>
  <svg class="cloud-mid" viewBox="0 0 1440 200" preserveAspectRatio="none">
    <path d="M0 158C120 132 210 162 330 150C450 138 520 112 650 128C780 144 850 168 980 156C1110 144 1190 112 1310 126C1370 133 1410 146 1440 152V200H0Z"></path>
  </svg>
  <svg class="cloud-front" viewBox="0 0 1440 200" preserveAspectRatio="none">
    <path d="M0 184C130 164 230 188 360 178C490 168 580 154 710 168C840 182 920 192 1050 182C1180 172 1280 158 1440 178V200H0Z"></path>
  </svg>
</div>
