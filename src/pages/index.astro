---
import { draftsVisible, essayUrl, formatDate, getEssays, readingMinutes } from '../lib/essays';

const essays = await getEssays();
const drafts = draftsVisible();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Oropis</title>
    <meta name="description" content="Essays on robotics, artificial intelligence, and finance." />
  </head>
  <body>
    <main>
      <h1>Oropis</h1>
      <p>
        {essays.length} essay{essays.length === 1 ? '' : 's'} visible
        {drafts ? ' (drafts included in development)' : ''}.
      </p>
      {
        essays.length === 0 ? (
          <p>No published essays yet.</p>
        ) : (
          <ul>
            {essays.map((essay) => (
              <li>
                <a href={essayUrl(essay)}>{essay.data.title}</a>
                <span> — {formatDate(essay.data.date)} — {readingMinutes(essay)} min read</span>
                {essay.data.draft ? <strong> — DRAFT</strong> : null}
              </li>
            ))}
          </ul>
        )
      }
    </main>
  </body>
</html>
