---
import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { COVERED_BEATS, getAllNews, SECTIONS, sectionStories, beatSlug } from '../lib/news';

const stories = await getAllNews();
const [lead, ...rest] = stories;
const latest = rest.slice(0, 4);
const grid = rest.slice(0, 7);
const sections = (Object.keys(SECTIONS) as Array<keyof typeof SECTIONS>).map((key) => ({
  key,
  ...SECTIONS[key],
  stories: sectionStories(stories.filter((story) => story.id !== lead?.id), key).slice(0, 3),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Oropis',
  url: 'https://oropis.com/',
  description: 'Independent coverage of artificial intelligence and robotics: frontier models, research, humanoids, autonomy, policy, and the business of the machine economy.',
  publisher: {
    '@type': 'Organization',
    name: 'Oropis',
    url: 'https://oropis.com/',
    sameAs: ['https://x.com/OropisHQ'],
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://oropis.com/search/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout jsonLd={jsonLd}>
  {stories.length === 0 ? (
    <section class="wrap empty-state">
      <p class="eyebrow">Desk open</p>
      <h2>No stories published yet.</h2>
      <p>The Oropis desk is preparing its first run. Check back shortly, or follow <a href="https://x.com/OropisHQ" rel="me noopener" target="_blank">@OropisHQ</a> for updates.</p>
    </section>
  ) : (
    <>
      <section class:list={['wrap', 'lead-grid', { 'lead-solo': latest.length === 0 }]} aria-labelledby="lead-title">
        <h2 id="lead-title" class="sr-only">Top story</h2>
        <StoryCard story={lead} variant="lead" />

        {latest.length > 0 && (
          <aside class="brief" aria-labelledby="brief-title">
            <div class="brief-head">
              <p class="eyebrow" id="brief-title">The brief</p>
              <a href="/news/">All stories &rarr;</a>
            </div>
            <ol class="brief-list">
              {latest.map((story) => (
                <li>
                  <a href={`/news/${story.id}/`}>{story.data.title}</a>
                  <span>{story.data.beat} · {story.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' })}</span>
                </li>
              ))}
            </ol>
          </aside>
        )}
      </section>

      {grid.length > 0 && (
        <section class="wrap section-block" aria-labelledby="latest-title">
          <SectionHeader eyebrow="Fresh off the desk" title="Latest" href="/news/" linkLabel="All coverage" />
          <div class="story-grid">
            {grid.map((story) => <StoryCard story={story} />)}
          </div>
        </section>
      )}

      {sections.map((section) => section.stories.length > 0 && (
        <section class="wrap section-block" aria-labelledby={`${section.key}-title`}>
          <SectionHeader eyebrow="Desk" title={section.title} href={`/${section.key}/`} linkLabel={`More ${section.title.toLowerCase()}`} />
          <div class="story-grid three">
            {section.stories.map((story) => <StoryCard story={story} variant="compact" />)}
          </div>
        </section>
      ))}

      <section class="wrap section-block" aria-labelledby="beats-title">
        <SectionHeader eyebrow="Beat map" title="Beats we cover" href="/beats/" linkLabel="All beats" />
        <ul class="beat-chips" id="beats-title">
          {COVERED_BEATS.map((beat) => (
            <li><a href={`/beats/${beatSlug(beat)}/`}>{beat}</a></li>
          ))}
        </ul>
      </section>

      <section class="wrap about-strip">
        <div>
          <p class="eyebrow">About the desk</p>
          <h2>Built for the people who want the signal.</h2>
        </div>
        <p>Oropis is an independent outlet covering artificial intelligence and robotics with original copy, clear sourcing, and no hype cycle. <a href="/about/">Read our approach &rarr;</a></p>
      </section>
    </>
  )}
</BaseLayout>
