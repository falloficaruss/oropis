---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { COVERED_GAMES, getAllNews, gameCode, gameSlug, fmtDate } from '../../lib/news';

const stories = await getAllNews();
const games = COVERED_GAMES.map((game) => {
  const gameStories = stories.filter((story) => story.data.game === game);
  return { game, slug: gameSlug(game), count: gameStories.length, latest: gameStories[0] };
});
---

<BaseLayout title="Games we cover" description="Oropis covers PUBG Mobile and BGMI, Free Fire, and Call of Duty: Mobile.">
  <section class="wrap page-head">
    <p class="eyebrow">Beat map</p>
    <h1>Three mobile beats</h1>
    <p>One desk for PUBG Mobile and BGMI, Free Fire, and Call of Duty: Mobile. Coverage follows the competitive calendar and the moves that change it.</p>
  </section>

  <section class="wrap">
    <div class="game-directory">
      {games.map((item) => (
        <a class="game-tile" href={`/games/${item.slug}/`}>
          <span class="game-monogram" aria-hidden="true">{gameCode(item.game)}</span>
          <span class="game-info">
            <strong>{item.game}</strong>
            <span>{item.count} {item.count === 1 ? 'story' : 'stories'}{item.latest ? ` · latest ${fmtDate(item.latest.data.pubDate)}` : ''}</span>
          </span>
          <span class="game-arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
