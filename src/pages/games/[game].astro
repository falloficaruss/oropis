---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { COVERED_GAMES, getAllNews, gameSlug, type Story } from '../../lib/news';

export async function getStaticPaths() {
  const stories = await getAllNews();
  return COVERED_GAMES.map((game) => ({
    params: { game: gameSlug(game) },
    props: { game, stories: stories.filter((story) => story.data.game === game) },
  }));
}

const { game, stories } = Astro.props as { game: string; stories: Story[] };
---

<BaseLayout title={`${game} news`} description={`Oropis coverage of ${game}: results, roster moves, patches, tournaments, and business.`}>
  <section class="wrap page-head">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Oropis</a><span aria-hidden="true">/</span><a href="/games/">Games</a><span aria-hidden="true">/</span><span>{game}</span>
    </nav>
    <p class="eyebrow">Game desk</p>
    <h1>{game}</h1>
    <p>{stories.length} {stories.length === 1 ? 'story' : 'stories'} published.</p>
  </section>

  <section class="wrap">
    {stories.length === 0 ? (
      <div class="empty-state"><h2>No stories filed yet.</h2><p>This desk is active. Coverage will appear here as stories publish.</p></div>
    ) : (
      <div class="story-grid two">
        {stories.map((story) => <StoryCard story={story} />)}
      </div>
    )}
  </section>
</BaseLayout>
