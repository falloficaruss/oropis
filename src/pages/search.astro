---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Search" description="Search Oropis coverage." noindex>
  <section class="wrap page-head">
    <p class="eyebrow">Find it</p>
    <h1>Search</h1>
    <p>Search published Oropis coverage by headline, game, or tag.</p>
  </section>

  <section class="wrap search-shell">
    <form class="search-form" role="search" id="search-form">
      <label class="sr-only" for="search-input">Search Oropis</label>
      <input id="search-input" name="q" type="search" placeholder="Teams, games, players, patches…" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
    <p class="search-status" id="search-status" aria-live="polite"></p>
    <div class="search-results" id="search-results"></div>
  </section>

  <script is:inline>
    (() => {
      const form = document.getElementById('search-form');
      const input = document.getElementById('search-input');
      const status = document.getElementById('search-status');
      const results = document.getElementById('search-results');
      let index = null;

      const fmt = (iso) =>
        new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(iso));

      const load = async () => {
        if (!index) {
          const response = await fetch('/search-index.json');
          index = await response.json();
        }
        return index;
      };

      const card = (item) => {
        const article = document.createElement('article');
        article.className = 'search-result';

        const meta = document.createElement('p');
        meta.className = 'story-meta';
        meta.textContent = `${item.game} · ${fmt(item.date)}`;

        const title = document.createElement('h2');
        const link = document.createElement('a');
        link.href = item.url;
        link.textContent = item.title;
        title.appendChild(link);

        const dek = document.createElement('p');
        dek.className = 'story-dek';
        dek.textContent = item.description;

        article.append(meta, title, dek);
        return article;
      };

      const run = async () => {
        const query = input.value.trim().toLowerCase();
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', input.value.trim());
        else url.searchParams.delete('q');
        window.history.replaceState({}, '', url);

        const items = await load();
        if (!query) {
          status.textContent = `${items.length} published ${items.length === 1 ? 'story' : 'stories'}. Type to filter.`;
          results.replaceChildren();
          return;
        }

        const matches = items.filter((item) => {
          const haystack = [item.title, item.description, item.game, item.archetype, ...(item.tags || [])].join(' ').toLowerCase();
          return haystack.includes(query);
        });

        status.textContent = `${matches.length} ${matches.length === 1 ? 'result' : 'results'} for “${input.value.trim()}”.`;
        results.replaceChildren(...(matches.length ? matches.map(card) : [Object.assign(document.createElement('p'), { className: 'empty-state', textContent: 'No stories matched. Try a team name or a game.' })]));
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        run();
      });

      const initial = new URLSearchParams(window.location.search).get('q');
      if (initial) {
        input.value = initial;
        run();
      } else {
        load().then((items) => {
          status.textContent = `${items.length} published ${items.length === 1 ? 'story' : 'stories'}. Type to filter.`;
        });
      }
    })();
  </script>
</BaseLayout>
