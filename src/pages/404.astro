---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found">
  <div class="container not-found">
    <p class="code">404</p>
    <h1>This weight state doesn't exist</h1>
    <p>Four states were in the register — this one isn't one of them.</p>
    <a class="plain" href="/" style="border-bottom:1px solid var(--accent); color:var(--accent); padding-bottom:2px;">← Back to the blog</a>
  </div>
</BaseLayout>