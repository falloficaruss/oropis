---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page is not on the server." noindex>
  <section class="wrap not-found">
    <p class="eyebrow">404</p>
    <h1>Out of bounds.</h1>
    <p>This page is not on the server. It may have been moved, unpublished, or never existed.</p>
    <div class="not-found-actions">
      <a class="button" href="/">Back to the front page</a>
      <a class="button ghost" href="/news/">Latest coverage</a>
    </div>
  </section>
</BaseLayout>
