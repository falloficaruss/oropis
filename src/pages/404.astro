---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist." current="">
  <section class="page-head shell">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p class="page-dek">That page does not exist. Try the archive or the homepage.</p>
  </section>

  <div class="essay-body reading prose">
    <p><a href="/">Return home</a> or browse the <a href="/archive/">archive</a>.</p>
  </div>
</BaseLayout>
