---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SourceList from '../../components/SourceList.astro';
import StoryCard from '../../components/StoryCard.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import {
  getAllNews,
  relatedStories,
  fmtDateLong,
  formatArchetype,
  beatSlug,
  storyUrl,
} from '../../lib/news';

export async function getStaticPaths() {
  const stories = await getAllNews();
  return stories.map((story) => ({ params: { slug: story.id }, props: { story, stories } }));
}

const { story, stories } = Astro.props;
const { title, description, pubDate, updatedDate, author, beat, archetype, tags, hero, heroCredit, heroAlt, sources } = story.data;
const { Content } = await render(story);
const related = relatedStories(story, stories);
const canonical = new URL(storyUrl(story), Astro.site).toString();
const label = formatArchetype(archetype);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  image: [new URL(hero ?? '/og-default.png', Astro.site).toString()],
  articleSection: beat,
  keywords: tags.join(', '),
  author: { '@type': 'Organization', name: author, url: 'https://oropis.com/about/' },
  publisher: {
    '@type': 'Organization',
    name: 'Oropis',
    url: 'https://oropis.com/',
    logo: { '@type': 'ImageObject', url: 'https://oropis.com/favicon.svg' },
    sameAs: ['https://x.com/OropisHQ'],
  },
};
---

<BaseLayout
  title={title}
  description={description}
  image={hero}
  type="article"
  published={pubDate}
  updated={updatedDate}
  jsonLd={jsonLd}
>
  <article class="article">
    <header class="article-head wrap narrow">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Oropis</a>
        <span aria-hidden="true">/</span>
        <a href="/news/">Latest</a>
        <span aria-hidden="true">/</span>
        <span>{label}</span>
      </nav>

      <div class="article-meta">
        <a class="pill" href={`/beats/${beatSlug(beat)}/`}>{beat}</a>
        <span class="pill ghost">{label}</span>
      </div>

      <h1>{title}</h1>
      <p class="article-dek">{description}</p>

      <p class="article-date">
        <time datetime={pubDate.toISOString()}>{fmtDateLong(pubDate)}</time>
        {updatedDate && updatedDate.getTime() !== pubDate.getTime() && (
          <> · Updated <time datetime={updatedDate.toISOString()}>{fmtDateLong(updatedDate)}</time></>
        )}
      </p>
    </header>

    {hero && (
      <figure class="article-hero wrap">
        <img src={hero} alt={heroAlt ?? ''} loading="eager" />
        {heroCredit && <figcaption>Image: {heroCredit}</figcaption>}
      </figure>
    )}

    <div class="article-layout wrap narrow">
      <div class="article-body prose">
        <Content />
      </div>
    </div>

    <div class="wrap narrow">
      <SourceList sources={sources} />
    </div>
  </article>

  {related.length > 0 && (
    <section class="wrap section-block related-block">
      <SectionHeader eyebrow="Keep reading" title="Related coverage" />
      <div class="story-grid three">
        {related.map((item) => <StoryCard story={item} variant="compact" />)}
      </div>
    </section>
  )}
</BaseLayout>
