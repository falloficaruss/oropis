---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Oropis',
  url: 'https://oropis.com/about/',
  mainEntity: {
    '@type': 'Organization',
    name: 'Oropis',
    url: 'https://oropis.com/',
    sameAs: ['https://x.com/OropisHQ'],
  },
};
---

<BaseLayout title="About" description="How Oropis reports, edits, and corrects PUBG Mobile, Free Fire, and Call of Duty: Mobile coverage." jsonLd={jsonLd}>
  <section class="wrap page-head">
    <p class="eyebrow">About the desk</p>
    <h1>Reported, not reposted.</h1>
    <p>Oropis is an independent outlet for mobile esports. We cover PUBG Mobile and BGMI, Free Fire, and Call of Duty: Mobile — the results, roster moves, patches, tournaments, and business decisions that shape the scene — with original copy and verifiable sourcing.</p>
  </section>

  <section class="wrap narrow prose">
    <h2>What we do</h2>
    <p>Our desk monitors public competitive records for three mobile beats: tournament pages, official publisher and esports announcements, organizer posts, patch notes, and public posts from teams and players. We turn those primary sources into short, readable stories for people who follow the scene closely.</p>

    <h2>How the desk works</h2>
    <p>Oropis uses software to monitor public sources and prepare a research packet for each candidate story. Every published article is reviewed by a human editor, rewritten in Oropis style, checked against the underlying sources, and approved before it goes live. We do not publish unreviewed automated copy.</p>
    <p>Stories carry a byline of <strong>OropisHQ</strong>. When a piece relies on another outlet's reporting, we link and credit it. We do not copy source text wholesale.</p>

    <h2>What we will not do</h2>
    <ul>
      <li>Publish unverified rumor as fact.</li>
      <li>Strip credit from original reporting.</li>
      <li>Use engagement bait to disguise a lack of reporting.</li>
      <li>Sell coverage or hide sponsorship.</li>
    </ul>

    <h2>Ownership and funding</h2>
    <p>Oropis is independently operated. The site has no advertising, sponsored content, or affiliate links at launch. If that changes, it will be disclosed clearly.</p>

    <h2>Corrections</h2>
    <p>We correct errors openly. See our <a href="/corrections/">corrections policy</a> for how to flag a mistake.</p>
  </section>
</BaseLayout>
