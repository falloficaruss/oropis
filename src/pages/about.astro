---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPosts, postUrl, fmtDate } from '../lib/posts';

const posts = await getAllPosts();
---

<BaseLayout title="About" active="/about" description="About Abhishek Shinde and Oropis — AI developer and researcher">
  <div class="container">
    <header class="about-hero">
      <div class="hero-pill-badge">
        <span>●</span> About the Lab &amp; Author
      </div>
      <h1>Abhishek Shinde</h1>
      <p style="font-family:var(--sans); font-size:0.85rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; color:var(--accent); margin: 0 0 20px;">
        AI Developer &amp; Independent Researcher
      </p>
      <p style="max-width:620px; color:var(--ink-soft); font-size:1.2rem; line-height:1.6; margin:0;">
        Oropis is where research and writing on efficient inference, low-bit LLMs, and hardware-aligned systems is published.
      </p>
    </header>

    <section class="about-section" id="about">
      <span class="section-label">Mission</span>
      <div class="section-content">
        <p>
          <strong>Short version.</strong> Building and studying models that fit closer to the hardware they run on.
        </p>
        <p>
          <strong>Longer version.</strong> Oropis works in public on low-bit language models, shift-oriented inference, and systems questions around them. The aim is direct: make the useful parts clear enough to be verified, benchmarked, and carried forward.
        </p>
        <p>
          Email is open at <a href="mailto:norizzabhii@gmail.com">norizzabhii@gmail.com</a>.
        </p>
      </div>
    </section>

    <section class="about-section" id="timeline">
      <span class="section-label">Timeline</span>
      <div class="section-content">
        <ul class="timeline">
          <li>
            <span class="when">Jul 2026</span>
            <span class="what">TetraNet — power-of-two quaternary weight paper &amp; kernels.</span>
          </li>
          <li>
            <span class="when">2025–2026</span>
            <span class="what">AI development, Triton kernels &amp; low-bit quantization experiments.</span>
          </li>
          <li>
            <span class="when">2024</span>
            <span class="what">First decoder language-model architecture experiments.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="about-section" id="projects">
      <span class="section-label">Key Project</span>
      <div class="section-content">
        <div class="project-grid">
          <a class="project-card" href="/posts/tetranet">
            <span class="type-tag research">Research Release</span>
            <h3>TetraNet</h3>
            <p>
              Power-of-two quaternary weights for small decoder-only language models. Eliminates FP multipliers while reclaiming the unused 4th state of 2-bit storage registers.
            </p>
            <div class="tags" style="margin-top:10px;">
              <span>quantization</span><span>pytorch</span><span>c++</span><span>triton</span>
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="about-section" id="publications">
      <span class="section-label">Publications</span>
      <div class="section-content">
        <div class="post-list">
          {posts.map((post) => (
            <a href={postUrl(post)} class="post-row">
              <span class="row-date">{fmtDate(post.data.date)}</span>
              <div class="row-tag">
                <span class:list={['type-tag', post.data.type]}>
                  {post.data.type === 'research' ? 'Research' : 'Blog'}
                </span>
              </div>
              <h3>{post.data.title}</h3>
              <span class="row-arrow">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>