---
interface Props {
  card?: boolean;
}

const { card = false } = Astro.props;

const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const line = '#cfc8b8';
const faint = '#8a8377';

const cell = 44;
const gap = 5;
const pitch = cell + gap;

const arenas = [
  { label: 'EPOCH 1 · CHAOS', hider: [2, 0], seeker: [1, 1], wall: null },
  { label: 'EPOCH 2 · PURSUIT', hider: [0, 2], seeker: [0, 0], wall: null },
  { label: 'EPOCH 3 · WALLS', hider: [0, 1], seeker: [2, 2], wall: [1, 1] },
  { label: 'EPOCH 4 · TOOL USE', hider: [2, 0], seeker: [0, 2], wall: [1, 0] },
];

const stair = [
  { x: 680, y: 180, label: 'RANDOM MOTION', c: faint },
  { x: 740, y: 245, label: 'PURSUIT / EVASION', c: ink },
  { x: 800, y: 310, label: 'ENVIRONMENT USE', c: accent },
  { x: 860, y: 375, label: 'TOOLS & EXPLOITS', c: accent },
  { x: 920, y: 440, label: 'COORDINATION', c: teal },
];
---

<svg
  viewBox="0 0 1200 675"
  role="img"
  aria-label="Self-play as a curriculum: agents in an arena escalate from random motion to pursuit, environment use, tools, and coordination, each strategy learned against the previous one"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="675" fill={paper} />

  <!-- Subtle dot lattice -->
  <g fill={line} opacity="0.4">
    {Array.from({ length: 17 }).map((_, i) =>
      Array.from({ length: 10 }).map((_, j) => (
        <circle cx={38 + i * 70} cy={38 + j * 66} r="1.3" />
      )),
    )}
  </g>

  <!-- Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    EMERGENT BEHAVIOR
  </text>
  {!card && (
    <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={faint}>
      SELF-PLAY · THE GAME IS THE CURRICULUM
    </text>
  )}

  <!-- Left Column: Four Epochs of Hide-and-Seek -->
  <g>
    <text x="60" y="126" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={faint}>
      FOUR EPOCHS OF HIDE-AND-SEEK
    </text>

    {arenas.map((a, k) => {
      const col = k % 2;
      const row = Math.floor(k / 2);
      const baseX = 60 + col * (3 * pitch + 36);
      const baseY = 150 + row * (3 * pitch + 48);

      return (
        <g>
          {Array.from({ length: 3 }).map((_, r) =>
            Array.from({ length: 3 }).map((_, c) => (
              <rect
                x={baseX + c * pitch}
                y={baseY + r * pitch}
                width={cell}
                height={cell}
                rx="6"
                fill="none"
                stroke={line}
                stroke-width="1.5"
              />
            )),
          )}
          {a.wall && (
            <rect
              x={baseX + a.wall[0] * pitch}
              y={baseY + a.wall[1] * pitch}
              width={cell}
              height={cell}
              rx="6"
              fill={ink}
              opacity="0.85"
            />
          )}
          <circle cx={baseX + a.seeker[0] * pitch + cell / 2} cy={baseY + a.seeker[1] * pitch + cell / 2} r="11" fill={teal} />
          <circle cx={baseX + a.hider[0] * pitch + cell / 2} cy={baseY + a.hider[1] * pitch + cell / 2} r="11" fill={accent} />
          
          <text x={baseX} y={baseY + 3 * pitch + 22} font-family="IBM Plex Mono, monospace" font-size="13" font-weight="700" letter-spacing="1" fill={faint}>
            {a.label}
          </text>
        </g>
      );
    })}
  </g>

  <!-- Right Column: Strategy Ladder -->
  <g>
    <text x="680" y="126" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={faint}>
      EACH STRATEGY LEARNED AGAINST LAST
    </text>

    {stair.map((s, i) => (
      <g>
        <circle cx={s.x} cy={s.y} r="10" fill={s.c} />
        <text x={s.x + 22} y={s.y + 5} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="700" letter-spacing="1" fill={s.c}>
          {s.label}
        </text>
        {i < stair.length - 1 && (
          <line
            x1={s.x + 8}
            y1={s.y + 8}
            x2={stair[i + 1].x - 8}
            y2={stair[i + 1].y - 8}
            stroke={line}
            stroke-width="2.5"
          />
        )}
      </g>
    ))}

    <!-- Outer Self-Play Loop Arc -->
    <path
      d={`M ${stair[4].x + 12} ${stair[4].y + 12} C ${stair[4].x + 130} ${stair[4].y + 20}, ${stair[0].x + 240} ${stair[0].y + 40}, ${stair[0].x + 12} ${stair[0].y - 12}`}
      fill="none"
      stroke={accent}
      stroke-width="2.5"
      stroke-dasharray="6 6"
    />
    <text x="960" y="270" font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="1.5" fill={accent}>
      SELF-PLAY LOOP
    </text>
  </g>

  <!-- Bottom Lane -->
  {!card && (
    <g>
      <line x1="60" y1="560" x2="1140" y2="560" stroke={line} stroke-width="2" />
      <text x="60" y="608" font-family="Newsreader Variable, Georgia, serif" font-size="28" font-style="italic" fill={ink}>
        the opponent is the environment
      </text>
      <text x="500" y="608" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="1" fill={faint}>
        NON-STATIONARY · ZERO-SUM ESCALATION · EMERGENCE ≠ INSTRUCTED
      </text>
    </g>
  )}
</svg>