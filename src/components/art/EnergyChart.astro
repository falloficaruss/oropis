---
const ink = '#1d1a15';
const paper = '#faf8f3';
const accentSoft = '#f4e3d8';
const accent = '#b4522a';
const gray = '#8a8377';
const line = '#e3ded2';
const dram = '#d8d2c4';

interface Row {
  name: string;
  bits: string;
  compute: number;
  dram: number;
  color: string;
  prop?: boolean;
  dim?: boolean;
}

const rows: Row[] = [
  { name: 'Full precision', bits: '32.00', compute: 0.0531, dram: 6.0398, color: ink },
  { name: 'Ternary, idealized coding', bits: '1.58', compute: 0.0156, dram: 0.9362, color: gray },
  { name: 'Ternary, 2-bit packed', bits: '2.00', compute: 0.0156, dram: 1.0067, color: gray, dim: true },
  { name: 'Uniform 2-bit', bits: '2.00', compute: 0.0164, dram: 1.0067, color: '#a3a096' },
  { name: 'Quaternary c = 1/4', bits: '2.00', compute: 0.0172, dram: 1.0067, color: accent, prop: true },
  { name: 'Quaternary c = 1/2', bits: '2.00', compute: 0.0164, dram: 1.0067, color: accent, prop: true, dim: true },
];

const x0 = 340;
const x1 = 1080;
const vmin = 0.01;
const vmax = 10;

const x = (v: number) => x0 + ((Math.log10(v) - Math.log10(vmin)) / (Math.log10(vmax) - Math.log10(vmin))) * (x1 - x0);

const rowH = 50;
const gap = 16;
const y0 = 190;

const grid = [0.01, 0.1, 1, 10];
---

<svg
  viewBox="0 0 1200 620"
  role="img"
  aria-label="Stacked bar chart of analytical energy per decoded token: compute versus DRAM weight reads"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="620" fill={paper} />

  <!-- Top Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    ANALYTICAL ENERGY PER DECODE TOKEN
  </text>
  <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={gray}>
    45NM OPERATION COSTS · 20 PJ/BIT DRAM RE-READ · LOG SCALE
  </text>

  <!-- Top Highlight Callout -->
  <g>
    <rect x="640" y="32" width="500" height="56" rx="8" fill={accentSoft} opacity="0.8" stroke={accent} stroke-width="1.5" />
    <text x="890" y="66" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="700" letter-spacing="1" fill={accent} text-anchor="middle">
      QUATERNARY ≈ 1.02 mJ/TOKEN ≈ 16.8% OF FP32
    </text>
  </g>

  <!-- Proposed Panel Background -->
  <rect x={x0 - 10} y={y0 + 4 * (rowH + gap) - 10} width={x1 - x0 + 20} height={2 * (rowH + gap) - 4} rx="8" fill={accentSoft} opacity="0.4" />

  <!-- Grid lines -->
  {grid.map((gv) => (
    <g>
      <line x1={x(gv)} y1={y0 - 20} x2={x(gv)} y2={y0 + rows.length * (rowH + gap) - 8} stroke={line} stroke-width="1.5" stroke-dasharray={gv === 1 ? 'none' : '3 6'} />
      <text x={x(gv)} y={y0 - 28} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="600" fill={gray} text-anchor="middle">
        {gv === 0.01 ? '0.01' : gv === 0.1 ? '0.1' : gv === 10 ? '10' : '1'} mJ
      </text>
    </g>
  ))}

  <!-- Rows -->
  {rows.map((r, i) => {
    const y = y0 + i * (rowH + gap);
    const totalEnergy = r.dram + r.compute;
    const barW = Math.max(x(totalEnergy) - x0, 4);
    const computeW = Math.max(x(totalEnergy) - x(r.dram), 4);
    return (
      <g>
        <line x1="60" y1={y + rowH + 6} x2={x1 + 80} y2={y + rowH + 6} stroke={line} stroke-width="1" opacity="0.6" />
        <text x="60" y={y + rowH - 22} font-family="Newsreader Variable, Georgia, serif" font-size="21" font-weight="500" fill={ink}>
          {r.name}
        </text>
        <text x="60" y={y + rowH - 4} font-family="IBM Plex Mono, monospace" font-size="14" font-weight="500" fill={gray}>
          {r.bits} bits/wt
        </text>
        
        <!-- DRAM bar -->
        <rect x={x0} y={y + 4} width={barW} height={rowH - 12} rx="6" fill={dram} opacity={r.dim ? 0.85 : 1} />
        <!-- Compute bar -->
        <rect x={x0 + barW - computeW} y={y + 4} width={computeW} height={rowH - 12} rx="3" fill={r.color} opacity={r.dim ? 0.85 : 1} />
        
        <text x={x0 + barW + 14} y={y + rowH - 12} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="700" fill={ink}>
          {totalEnergy.toFixed(4)}
        </text>
      </g>
    );
  })}

  <!-- Legend -->
  <g>
    <rect x="60" y={y0 + rows.length * (rowH + gap) + 24} width="20" height="20" rx="4" fill={dram} />
    <text x="90" y={y0 + rows.length * (rowH + gap) + 39} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="600" fill={ink}>
      DRAM weight reads
    </text>
    <rect x="280" y={y0 + rows.length * (rowH + gap) + 24} width="20" height="20" rx="4" fill={accent} />
    <text x="310" y={y0 + rows.length * (rowH + gap) + 39} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="600" fill={ink}>
      Compute
    </text>
  </g>
</svg>