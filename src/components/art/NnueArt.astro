---
interface Props {
  card?: boolean;
}

const { card = false } = Astro.props;

const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const line = '#cfc8b8';
const faint = '#8a8377';

const boardCell = 52;
const boardGap = 2;
const bx = 80;
const by = 168;

const litCells = [
  { x: bx + 1 * (boardCell + boardGap), y: by + 2 * (boardCell + boardGap) },
  { x: bx + 3 * (boardCell + boardGap), y: by + 0 * (boardCell + boardGap) },
];

const inX = 540;
const inY0 = 150;
const inPitch = 20;
const inN = 16;

const h1X = 730;
const h1Y0 = 118;
const h1Pitch = 30;
const h1N = 12;

const h2X = 900;
const h2Y0 = 175;
const h2Pitch = 38;
const h2N = 8;

const outX = 1060;
const outY = 316;
const outS = 46;

const h1Cy = (i: number) => h1Y0 + i * h1Pitch;
const h2Cy = (i: number) => h2Y0 + i * h2Pitch;

const accentLinks = litCells.flatMap((c) =>
  Array.from({ length: h1N }).map((_, i) => ({
    x1: c.x + boardCell / 2,
    y1: c.y + boardCell / 2,
    x2: h1X - 16,
    y2: h1Cy(i),
  })),
);

const h1Links = Array.from({ length: h1N }).flatMap((_, i) =>
  Array.from({ length: h2N }).map((_, j) => ({
    x1: h1X + 16,
    y1: h1Cy(i),
    x2: h2X - 16,
    y2: h2Cy(j),
  })),
);

const h2Links = Array.from({ length: h2N }).map((_, i) => ({
  x1: h2X + 16,
  y1: h2Cy(i),
  x2: outX - outS / 2 - 8,
  y2: outY + outS / 2,
}));
---

<svg
  viewBox="0 0 1200 675"
  role="img"
  aria-label="The NNUE network 1x256x32x1 with incremental update: one move flips two features and only two rows of the hidden layer are recomputed"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="675" fill={paper} />

  <!-- Subtle dot lattice -->
  <g fill={line} opacity="0.4">
    {Array.from({ length: 17 }).map((_, i) =>
      Array.from({ length: 10 }).map((_, j) => (
        <circle cx={38 + i * 70} cy={38 + j * 66} r="1.3" />
      )),
    )}
  </g>

  <!-- Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    EFFICIENTLY UPDATABLE
  </text>
  {!card && (
    <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={faint}>
      1×256×32×1 · HALFKP · Δ-UPDATE SCHEME
    </text>
  )}

  <!-- Mini Board -->
  <g>
    <text x="80" y="145" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={faint}>
      ONE MOVE
    </text>
    {Array.from({ length: 4 }).map((_, r) =>
      Array.from({ length: 4 }).map((_, c) => (
        <rect
          x={bx + c * (boardCell + boardGap)}
          y={by + r * (boardCell + boardGap)}
          width={boardCell}
          height={boardCell}
          rx="6"
          fill={(r + c) % 2 === 0 ? line : paper}
          stroke={line}
          stroke-width="1.5"
        />
      )),
    )}
    <rect x={litCells[0].x} y={litCells[0].y} width={boardCell} height={boardCell} rx="6" fill={accent} />
    <rect x={litCells[1].x} y={litCells[1].y} width={boardCell} height={boardCell} rx="6" fill="none" stroke={ink} stroke-width="3" />
    <path
      d={`M ${litCells[0].x + boardCell / 2} ${litCells[0].y + boardCell / 2} C ${litCells[0].x + 40} ${litCells[0].y - 40}, ${litCells[1].x - 40} ${litCells[1].y + 40}, ${litCells[1].x + boardCell / 2} ${litCells[1].y + boardCell / 2}`}
      fill="none"
      stroke={accent}
      stroke-width="3"
      stroke-dasharray="3 6"
    />
    <text x="80" y={by + 4 * (boardCell + boardGap) + 34} font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="1" fill={ink}>
      TWO FEATURES FLIP
    </text>
  </g>

  <!-- Network -->
  <g>
    {accentLinks.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={accent} stroke-width="1.3" opacity="0.35" />
    ))}
    {h1Links.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={line} stroke-width="1.2" opacity="0.7" />
    ))}
    {h2Links.map((l) => (
      <line x1={l.x1} y1={l.y1} x2={l.x2} y2={l.y2} stroke={teal} stroke-width="1.5" opacity="0.5" />
    ))}

    <text x={inX - 10} y="128" font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="1" fill={faint} text-anchor="middle">
      ~41K INPUTS
    </text>
    {Array.from({ length: inN }).map((_, i) => {
      const y = inY0 + i * inPitch;
      const lit = litCells.some((c) => Math.abs(c.y + boardCell / 2 - (y + 8)) < 40);
      return lit ? (
        <rect x={inX} y={y} width="16" height="16" rx="4" fill={accent} />
      ) : (
        <rect x={inX} y={y} width="16" height="16" rx="4" fill="none" stroke={ink} stroke-width="1.8" />
      );
    })}

    <text x={h1X} y="94" font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="1" fill={faint} text-anchor="middle">
      256 HIDDEN
    </text>
    {Array.from({ length: h1N }).map((_, i) => (
      <circle cx={h1X} cy={h1Cy(i)} r="10" fill={ink} />
    ))}

    <text x={h2X} y="150" font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="1" fill={faint} text-anchor="middle">
      32 HIDDEN
    </text>
    {Array.from({ length: h2N }).map((_, i) => (
      <circle cx={h2X} cy={h2Cy(i)} r="9" fill={teal} />
    ))}

    <rect x={outX - outS / 2} y={outY - outS / 2} width={outS} height={outS} rx="10" fill={accent} />
    <text x={outX} y={outY + 7} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={paper} text-anchor="middle">
      σ
    </text>
    <text x={outX} y={outY + outS / 2 + 28} font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="1" fill={faint} text-anchor="middle">
      SCORE
    </text>
  </g>

  <!-- Incremental Update Lane -->
  {!card && (
    <g>
      <line x1="60" y1="520" x2="1140" y2="520" stroke={line} stroke-width="2" />
      <text x="60" y="565" font-family="Newsreader Variable, Georgia, serif" font-size="28" font-style="italic" fill={ink}>
        a′ = a + w · Δx
      </text>
      <text x="300" y="565" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="1" fill={faint}>
        TWO ROWS RECOMPUTED · 2 × 256 FMAs · LAYERS 2–3 UNTOUCHED
      </text>
    </g>
  )}
</svg>