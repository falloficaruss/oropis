---
interface Props {
  card?: boolean;
}

const { card = false } = Astro.props;

const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const line = '#cfc8b8';
const faint = '#8a8377';

const cell = 30;
const gap = 6;
const pitch = cell + gap;

const rows = [
  [1, 2, 3, 4, 3, 2, 1, 0],
  [0, 1, 2, 3, 4, 3, 2, 1],
];

const x0 = 596;
const y0 = 175;

interface Cell {
  x: number;
  y: number;
  state: 'plus' | 'minus' | 'cp' | 'cm';
}

const cells: Cell[] = [];

rows.forEach((counts, r) => {
  counts.forEach((fill, b) => {
    for (let k = 0; k < 4; k++) {
      const filled = k >= 4 - fill;
      const isAccent = (r * 8 + b + k) % 3 === 0;
      cells.push({
        x: x0 + (b * 4 + k) * pitch,
        y: y0 + r * 60,
        state: !filled ? (isAccent ? 'cm' : 'minus') : isAccent ? 'cp' : 'plus',
      });
    }
  });
});
---

<svg
  viewBox="0 0 1200 675"
  role="img"
  aria-label="Two-bit quaternary weight grid packed into bytes, with shift-based scaling"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="675" fill={paper} />

  <!-- Subtle dot lattice -->
  <g fill={line} opacity="0.4">
    {Array.from({ length: 17 }).map((_, i) =>
      Array.from({ length: 10 }).map((_, j) => (
        <circle cx={38 + i * 70} cy={38 + j * 66} r="1.3" />
      )),
    )}
  </g>

  <!-- Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    2 BITS · 4 STATES
  </text>
  {!card && (
    <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={faint}>
      POWER-OF-TWO QUATERNARY WEIGHTS · ZERO MULTIPLIES
    </text>
  )}

  <!-- Legend -->
  <g>
    <text x="60" y="155" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={faint}>
      ALPHABET MAPPING
    </text>
    {[
      { state: 'plus', label: '00 · +1', y: 200 },
      { state: 'minus', label: '01 · −1', y: 275 },
      { state: 'cp', label: '10 · +c', y: 350 },
      { state: 'cm', label: '11 · −c', y: 425 },
    ].map((item) => (
      <g>
        <rect x="60" y={item.y - 22} width="44" height="44" rx="7" fill="none" stroke={item.state === 'plus' || item.state === 'cp' ? ink : accent} stroke-width="2.5" />
        {item.state === 'plus' && <rect x="67" y={item.y - 15} width="30" height="30" rx="5" fill={ink} />}
        {item.state === 'cp' && <rect x="67" y={item.y - 15} width="30" height="30" rx="5" fill={accent} />}
        {item.state === 'cm' && <rect x="67" y={item.y - 15} width="30" height="30" rx="5" fill="none" stroke={accent} stroke-width="2.5" />}
        <text x="125" y={item.y + 7} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink}>
          {item.label}
        </text>
      </g>
    ))}
  </g>

  <!-- Byte Stream -->
  <g>
    <text x="596" y="132" font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={faint}>
      ONE REGISTER · 8 BYTES · 16 BITS
    </text>
    {cells.map((c) =>
      c.state === 'plus' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill={ink} />
      ) : c.state === 'cp' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill={accent} />
      ) : c.state === 'minus' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill="none" stroke={ink} stroke-width="2.5" />
      ) : (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill="none" stroke={accent} stroke-width="2.5" />
      ),
    )}
    {Array.from({ length: 9 }).map((_, i) => (
      <line x1={x0 + i * 4 * pitch - gap / 2} y1={y0 - 10} x2={x0 + i * 4 * pitch - gap / 2} y2={y0 + 96} stroke={line} stroke-width="2" stroke-dasharray="4 6" />
    ))}
    {Array.from({ length: 8 }).map((_, i) => (
      <text x={x0 + i * 4 * pitch + pitch * 1.5} y={y0 - 18} font-family="IBM Plex Mono, monospace" font-size="14" font-weight="600" fill={faint} text-anchor="middle">
        {i + 1}
      </text>
    ))}
  </g>

  <!-- Shift Lane (Bottom) -->
  {!card && (
    <g>
      <line x1="60" y1="520" x2="1140" y2="520" stroke={line} stroke-width="2" />
      {[
        { w: 52, x: 80, label: '1.0', sub: 'no shift' },
        { w: 34, x: 290, label: '½', sub: '» 1 shift' },
        { w: 22, x: 500, label: '¼', sub: '» 2 shifts' },
      ].map((s, i) => (
        <g>
          <rect x={s.x} y={560 - s.w / 2} width={s.w} height={s.w} rx="6" fill={i === 0 ? ink : accent} opacity={i === 0 ? 1 : 0.92} />
          <text x={s.x + s.w + 16} y={560 + 6} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink}>
            {s.label}
          </text>
          {s.sub && (
            <text x={s.x + s.w + 16} y={584} font-family="IBM Plex Mono, monospace" font-size="14" font-weight="600" letter-spacing="1" fill={faint}>
              {s.sub}
            </text>
          )}
        </g>
      ))}
      <text x="700" y="555" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="700" letter-spacing="1.5" fill={ink}>
        SHIFT, DON'T MULTIPLY
      </text>
      <text x="700" y="582" font-family="IBM Plex Mono, monospace" font-size="15" letter-spacing="1" fill={faint}>
        c ∈ {`{½, ¼}`} → {`{1, 2}`} ARITHMETIC BIT-SHIFTS
      </text>
    </g>
  )}
</svg>
