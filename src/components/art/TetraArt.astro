---
interface Props {
  card?: boolean;
}

const { card = false } = Astro.props;

const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const line = '#cfc8b8';
const faint = '#8a8377';

const cell = 30;
const gap = 6;
const pitch = cell + gap;

const rows = [
  [1, 2, 3, 4, 3, 2, 1, 0],
  [0, 1, 2, 3, 4, 3, 2, 1],
];

const x0 = 596;
const y0 = 168;

interface Cell {
  x: number;
  y: number;
  state: 'plus' | 'minus' | 'cp' | 'cm';
}

const cells: Cell[] = [];

rows.forEach((counts, r) => {
  counts.forEach((fill, b) => {
    for (let k = 0; k < 4; k++) {
      const filled = k >= 4 - fill;
      const isAccent = (r * 8 + b + k) % 3 === 0;
      cells.push({
        x: x0 + (b * 4 + k) * pitch,
        y: y0 + r * 60,
        state: !filled ? (isAccent ? 'cm' : 'minus') : isAccent ? 'cp' : 'plus',
      });
    }
  });
});
---

<svg
  viewBox="0 0 1200 675"
  role="img"
  aria-label="Two-bit quaternary weight grid packed into bytes, with shift-based scaling"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="1200" height="675" fill={paper} />

  <!-- subtle dot lattice -->
  <g fill={line} opacity="0.5">
    {Array.from({ length: 17 }).map((_, i) =>
      Array.from({ length: 10 }).map((_, j) => (
        <circle cx={38 + i * 70} cy={38 + j * 66} r="1.3" />
      )),
    )}
  </g>

  <text x="80" y="96" font-family="IBM Plex Mono, monospace" font-size="15" letter-spacing="4" fill={ink}>
    2 BITS · 4 STATES
  </text>
  {!card && (
    <text x="80" y="122" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="2" fill={faint}>
      0 MULTIPLIES
    </text>
  )}

  <!-- legend -->
  <g>
    <text x="80" y="212" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2" fill={faint}>
      ALPHABET
    </text>
    {[
      { state: 'plus', label: '00 · +1', y: 248 },
      { state: 'minus', label: '01 · −1', y: 322 },
      { state: 'cp', label: '10 · +c', y: 396 },
      { state: 'cm', label: '11 · −c', y: 470 },
    ].map((item) => (
      <g>
        <rect x="80" y={item.y - 26} width="48" height="48" rx="7" fill="none" stroke={item.state === 'plus' || item.state === 'cp' ? ink : accent} stroke-width="2" />
        {item.state === 'plus' && <rect x="86" y={item.y - 20} width="36" height="36" rx="5" fill={ink} />}
        {item.state === 'cp' && <rect x="86" y={item.y - 20} width="36" height="36" rx="5" fill={accent} />}
        {item.state === 'cm' && <rect x="86" y={item.y - 20} width="36" height="36" rx="5" fill="none" stroke={accent} stroke-width="2.5" />}
        <text x="148" y={item.y + 5} font-family="IBM Plex Mono, monospace" font-size="16" fill={ink}>
          {item.label}
        </text>
      </g>
    ))}
  </g>

  <!-- byte stream -->
  <g>
    <text x="596" y="132" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2" fill={faint}>
      ONE REGISTER · 8 BYTES · 16 BITS
    </text>
    {cells.map((c) =>
      c.state === 'plus' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill={ink} />
      ) : c.state === 'cp' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill={accent} />
      ) : c.state === 'minus' ? (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill="none" stroke={ink} stroke-width="2.5" />
      ) : (
        <rect x={c.x} y={c.y} width={cell} height={cell} rx="6" fill="none" stroke={accent} stroke-width="2.5" />
      ),
    )}
    {Array.from({ length: 9 }).map((_, i) => (
      <line x1={x0 + i * 4 * pitch - gap / 2} y1={y0 - 10} x2={x0 + i * 4 * pitch - gap / 2} y2={y0 + 96} stroke={line} stroke-width="1.5" stroke-dasharray="3 5" />
    ))}
    {Array.from({ length: 8 }).map((_, i) => (
      <text x={x0 + i * 4 * pitch + pitch * 1.5} y={y0 - 22} font-family="IBM Plex Mono, monospace" font-size="11" fill={faint} text-anchor="middle">
        {i + 1}
      </text>
    ))}
  </g>

  <!-- shift lane -->
  {!card && (
    <g>
      <line x1="80" y1="560" x2="1120" y2="560" stroke={line} stroke-width="1.5" />
      {[
        { w: 56, x: 120, label: '1.0', sub: '' },
        { w: 28, x: 330, label: '½', sub: '» 1' },
        { w: 14, x: 540, label: '¼', sub: '» 2' },
      ].map((s, i) => (
        <g>
          <rect x={s.x} y={560 - s.w / 2} width={s.w} height={s.w} rx="6" fill={i === 0 ? ink : accent} opacity={i === 0 ? 1 : 0.92} />
          <text x={s.x + s.w + 14} y={560 + 5} font-family="IBM Plex Mono, monospace" font-size="15" fill={ink}>
            {s.label}
          </text>
          {s.sub && (
            <text x={s.x + s.w + 14} y={580} font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="1" fill={faint}>
              {s.sub}
            </text>
          )}
        </g>
      ))}
      <text x="660" y="555" font-family="IBM Plex Mono, monospace" font-size="14" letter-spacing="2" fill={faint}>
        SHIFT, DON'T MULTIPLY
      </text>
      <text x="660" y="578" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="1" fill={faint}>
        c ∈ {`{½, ¼}`} → {`{1, 2}`} ARITHMETIC SHIFTS
      </text>
    </g>
  )}
</svg>
