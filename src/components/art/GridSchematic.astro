---
const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const gray = '#8a8377';
const line = '#e3ded2';

// number line: -1 .. 1, c = 1/2, b = (1+c)/2 = 0.75
const cx = 600;
const unit = 480;
const xv = (v: number) => cx + v * unit;

const regions = [
  { from: -1, to: -0.75, label: '−1', color: ink },
  { from: -0.75, to: 0, label: '−c', color: accent },
  { from: 0, to: 0.75, label: '+c', color: accent },
  { from: 0.75, to: 1, label: '+1', color: ink },
];

const codes = [
  { code: '00', value: '+1', solid: true, color: ink },
  { code: '01', value: '−1', solid: false, color: ink },
  { code: '10', value: '+c', solid: true, color: accent },
  { code: '11', value: '−c', solid: false, color: accent },
];

const yLine = 220;
const chipY = 360;
---

<svg
  viewBox="0 0 1200 520"
  role="img"
  aria-label="Quaternary quantizer: number line with two thresholds, and two-bit codeword mapping"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="1200" height="520" fill={paper} />

  <text x="80" y="88" font-family="IBM Plex Mono, monospace" font-size="14" letter-spacing="3" fill={ink}>
    THE QUANTIZER
  </text>
  <text x="80" y="112" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2" fill={gray}>
    TWO THRESHOLDS AT ±(1+c)/2 · c = ½ SHOWN
  </text>

  <!-- region strips -->
  {regions.map((r) => (
    <g>
      <rect x={xv(r.from)} y={yLine - 26} width={xv(r.to) - xv(r.from)} height="52" rx="6" fill={r.color} opacity="0.10" />
      <text x={(xv(r.from) + xv(r.to)) / 2} y={yLine + 6} font-family="IBM Plex Mono, monospace" font-size="19" fill={r.color} text-anchor="middle">
        {r.label}
      </text>
    </g>
  ))}

  <!-- number line -->
  <line x1={xv(-1)} y1={yLine} x2={xv(1)} y2={yLine} stroke={ink} stroke-width="2.5" />
  {[-1, -0.75, 0, 0.75, 1].map((t) => (
    <g>
      <line x1={xv(t)} y1={yLine - 9} x2={xv(t)} y2={yLine + 9} stroke={ink} stroke-width="2.5" />
      {t !== -0.75 && t !== 0.75 && (
        <text x={xv(t)} y={yLine + 30} font-family="IBM Plex Mono, monospace" font-size="16" fill={ink} text-anchor="middle">
          {t}
        </text>
      )}
      {(t === -0.75 || t === 0.75) && (
        <text x={xv(t)} y={yLine + 30} font-family="IBM Plex Mono, monospace" font-size="15" fill={gray} text-anchor="middle">
          {t < 0 ? '−b' : '+b'}
        </text>
      )}
    </g>
  ))}

  <!-- codewords -->
  {codes.map((c, i) => {
    const x = 200 + i * 210;
    return (
      <g>
        <rect x={x - 20} y={chipY - 20} width="40" height="40" rx="6" fill="none" stroke={c.color} stroke-width="2.5" />
        {c.solid && <rect x={x - 14} y={chipY - 14} width="28" height="28" rx="4" fill={c.color} />}
        <text x={x} y={chipY + 46} font-family="IBM Plex Mono, monospace" font-size="15" fill={ink} text-anchor="middle">
          {c.code}
        </text>
        <text x={x} y={chipY - 36} font-family="IBM Plex Mono, monospace" font-size="17" fill={c.color} text-anchor="middle">
          {c.value}
        </text>
      </g>
    );
  })}

  <line x1="110" y1={chipY} x2="300" y2={chipY} stroke={gray} stroke-width="1" stroke-dasharray="3 5" />

  <!-- shift note -->
  <g>
    <rect x="500" y="300" width="320" height="120" rx="10" fill="none" stroke={line} stroke-width="1.5" />
    <text x="520" y="335" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="1" fill={ink}>
      SHIFT COST PER STATE
    </text>
    <text x="520" y="362" font-family="IBM Plex Mono, monospace" font-size="14" fill={ink}>
      c = ½ · code 10 → 1 arithmetic shift
    </text>
    <text x="520" y="386" font-family="IBM Plex Mono, monospace" font-size="14" fill={ink}>
      c = ¼ · code 10 → 2 arithmetic shifts
    </text>
    <text x="520" y="410" font-family="IBM Plex Mono, monospace" font-size="12" fill={teal}>
      no multiplier touched
    </text>
  </g>

  <line x1="860" y1="340" x2="960" y2="340" stroke={teal} stroke-width="1" stroke-dasharray="2 4" />
  <text x="980" y="345" font-family="IBM Plex Mono, monospace" font-size="12" fill={teal}>
    10 → 01
  </text>
</svg>