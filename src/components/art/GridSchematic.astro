---
const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const gray = '#8a8377';
const line = '#e3ded2';

// number line: -1 .. 1, c = 1/2, b = (1+c)/2 = 0.75
const cx = 600;
const unit = 440;
const xv = (v: number) => cx + v * unit;

const regions = [
  { from: -1, to: -0.75, label: '−1', color: ink },
  { from: -0.75, to: 0, label: '−c', color: accent },
  { from: 0, to: 0.75, label: '+c', color: accent },
  { from: 0.75, to: 1, label: '+1', color: ink },
];

const codes = [
  { code: '00', value: '+1', solid: true, color: ink },
  { code: '01', value: '−1', solid: false, color: ink },
  { code: '10', value: '+c', solid: true, color: accent },
  { code: '11', value: '−c', solid: false, color: accent },
];

const yLine = 190;
const chipY = 370;
---

<svg
  viewBox="0 0 1200 540"
  role="img"
  aria-label="Quaternary quantizer: number line with two thresholds, and two-bit codeword mapping"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="540" fill={paper} />

  <!-- Top Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    THE QUANTIZER SCHEMATIC
  </text>
  <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={gray}>
    TWO THRESHOLDS AT ±(1+c)/2 · c = ½ SHOWN
  </text>

  <!-- Region strips -->
  {regions.map((r) => (
    <g>
      <rect x={xv(r.from)} y={yLine - 28} width={xv(r.to) - xv(r.from)} height="56" rx="8" fill={r.color} opacity="0.10" />
      <text x={(xv(r.from) + xv(r.to)) / 2} y={yLine + 8} font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" fill={r.color} text-anchor="middle">
        {r.label}
      </text>
    </g>
  ))}

  <!-- Number line -->
  <line x1={xv(-1)} y1={yLine} x2={xv(1)} y2={yLine} stroke={ink} stroke-width="3.5" />
  {[-1, -0.75, 0, 0.75, 1].map((t) => (
    <g>
      <line x1={xv(t)} y1={yLine - 12} x2={xv(t)} y2={yLine + 12} stroke={ink} stroke-width="3.5" />
      {t !== -0.75 && t !== 0.75 && (
        <text x={xv(t)} y={yLine + 38} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink} text-anchor="middle">
          {t}
        </text>
      )}
      {(t === -0.75 || t === 0.75) && (
        <text x={xv(t)} y={yLine + 38} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={gray} text-anchor="middle">
          {t < 0 ? '−b' : '+b'}
        </text>
      )}
    </g>
  ))}

  <!-- Codeword Chips (Arranged on left) -->
  <g>
    <text x="60" y={chipY - 60} font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" letter-spacing="2" fill={gray}>
      CODEWORD MAPPINGS
    </text>

    {codes.map((c, i) => {
      const x = 110 + i * 145;
      return (
        <g>
          <rect x={x - 24} y={chipY - 24} width="48" height="48" rx="8" fill="none" stroke={c.color} stroke-width="3" />
          {c.solid && <rect x={x - 16} y={chipY - 16} width="32" height="32" rx="5" fill={c.color} />}
          <text x={x} y={chipY - 38} font-family="IBM Plex Mono, monospace" font-size="20" font-weight="700" fill={c.color} text-anchor="middle">
            {c.value}
          </text>
          <text x={x} y={chipY + 52} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink} text-anchor="middle">
            {c.code}
          </text>
        </g>
      );
    })}
  </g>

  <!-- Shift Note Card (Placed cleanly on right) -->
  <g>
    <rect x="670" y={chipY - 70} width="470" height="145" rx="10" fill="none" stroke={line} stroke-width="2" />
    <rect x="670" y={chipY - 70} width="470" height="145" rx="10" fill={paper} opacity="0.9" />
    <text x="695" y={chipY - 38} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="700" letter-spacing="1.5" fill={ink}>
      SHIFT COST PER STATE
    </text>
    <text x="695" y={chipY - 6} font-family="IBM Plex Mono, monospace" font-size="16" fill={ink}>
      c = ½ · codeword 10 → 1 arithmetic shift
    </text>
    <text x="695" y={chipY + 24} font-family="IBM Plex Mono, monospace" font-size="16" fill={ink}>
      c = ¼ · codeword 10 → 2 arithmetic shifts
    </text>
    <text x="695" y={chipY + 54} font-family="IBM Plex Mono, monospace" font-size="15" font-weight="700" fill={teal}>
      ✓ Zero floating-point multipliers touched
    </text>
  </g>
</svg>