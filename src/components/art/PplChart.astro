---
const ink = '#1d1a15';
const paper = '#faf8f3';
const panel = '#f2eee4';
const accent = '#b4522a';
const accentSoft = '#f4e3d8';
const teal = '#2c6e66';
const gray = '#8a8377';
const line = '#e3ded2';

const rows = [
  { name: 'Full precision', ppl: 65.23, color: ink },
  { name: 'BitNet-style ternary', ppl: 79.03, color: gray },
  { name: 'Uniform 2-bit', ppl: 77.65, color: teal },
  { name: 'Quaternary c = 1/4', ppl: 76.73, color: accent, prop: true },
  { name: 'Quaternary c = 1/2', ppl: 77.57, color: accent, prop: true, dim: true },
];

const x0 = 340;
const x1 = 1140;
const vmin = 60;
const vmax = 82;

const x = (v: number) => x0 + ((v - vmin) / (vmax - vmin)) * (x1 - x0);
const rowH = 52;
const gap = 20;
const y0 = 170;
---

<svg
  viewBox="0 0 1200 520"
  role="img"
  aria-label="Bar chart of validation perplexity across five training conditions"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="1200" height="520" fill={paper} />

  <text x="80" y="88" font-family="IBM Plex Mono, monospace" font-size="14" letter-spacing="3" fill={ink}>
    FROZEN VALIDATION PERPLEXITY
  </text>
  <text x="80" y="112" font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2" fill={gray}>
    TINYSTORIES · 9.4M PARAMS · LOWER IS BETTER
  </text>

  <!-- proposed panel -->
  <rect x={x0 - 14} y={y0 + 2 * (rowH + gap) - 16} width={x1 - x0 + 28} height={2 * (rowH + gap) - 8} rx="10" fill={accentSoft} opacity="0.55" />
  <text x={x1 + 10} y={y0 + 3 * (rowH + gap) - 8} font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="2" fill={accent}>
    PROPOSED
  </text>

  {rows.map((r, i) => {
    const y = y0 + i * (rowH + gap);
    const barW = x(r.ppl) - x0;
    return (
      <g>
        <line x1={x0} y1={y + rowH} x2={x1} y2={y + rowH} stroke={line} stroke-width="1" />
        <text x="80" y={y + rowH - 12} font-family="Newsreader Variable, Georgia, serif" font-size="19" fill={ink}>
          {r.name}
        </text>
        <rect x={x0} y={y + 4} width={Math.max(barW, 6)} height={rowH - 8} rx="8" fill={r.color} opacity={r.dim ? 0.75 : 1} />
        <text x={x0 + barW + 14} y={y + rowH - 14} font-family="IBM Plex Mono, monospace" font-size="17" fill={ink}>
          {r.ppl.toFixed(2)}
        </text>
        {i === 0 && (
          <g>
            <text x={x(62)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377">62</text>
            <text x={x(66)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377" text-anchor="middle">66</text>
            <text x={x(70)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377" text-anchor="middle">70</text>
            <text x={x(74)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377" text-anchor="middle">74</text>
            <text x={x(78)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377" text-anchor="middle">78</text>
            <text x={x(82)} y={y - 4} font-family="IBM Plex Mono, monospace" font-size="12" fill="#8a8377" text-anchor="end">82</text>
          </g>
        )}
      </g>
    );
  })}
</svg>