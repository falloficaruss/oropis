---
const ink = '#1d1a15';
const paper = '#faf8f3';
const panel = '#f2eee4';
const accent = '#b4522a';
const accentSoft = '#f4e3d8';
const teal = '#2c6e66';
const gray = '#8a8377';
const line = '#e3ded2';

const rows = [
  { name: 'Full precision', ppl: 65.23, color: ink },
  { name: 'BitNet-style ternary', ppl: 79.03, color: gray },
  { name: 'Uniform 2-bit', ppl: 77.65, color: teal },
  { name: 'Quaternary c = 1/4', ppl: 76.73, color: accent, prop: true },
  { name: 'Quaternary c = 1/2', ppl: 77.57, color: accent, prop: true, dim: true },
];

const x0 = 340;
const x1 = 1000;
const vmin = 60;
const vmax = 82;

const x = (v: number) => x0 + ((v - vmin) / (vmax - vmin)) * (x1 - x0);
const rowH = 50;
const gap = 18;
const y0 = 170;
---

<svg
  viewBox="0 0 1200 540"
  role="img"
  aria-label="Bar chart of validation perplexity across five training conditions"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="540" fill={paper} />

  <!-- Top Title & Subtitle -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    FROZEN VALIDATION PERPLEXITY
  </text>
  <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={gray}>
    TINYSTORIES · 9.4M PARAMS · LOWER IS BETTER
  </text>

  <!-- Proposed Highlight Panel -->
  <rect x={x0 - 10} y={y0 + 3 * (rowH + gap) - 12} width={x1 - x0 + 20} height={2 * (rowH + gap) - 6} rx="8" fill={accentSoft} opacity="0.5" />
  <text x={x1 + 20} y={y0 + 4 * (rowH + gap) - 12} font-family="IBM Plex Mono, monospace" font-size="14" font-weight="700" letter-spacing="2" fill={accent}>
    PROPOSED
  </text>

  <!-- Grid Scale Ticks -->
  <g>
    {[62, 66, 70, 74, 78, 82].map((val) => (
      <g>
        <line x1={x(val)} y1={y0 - 14} x2={x(val)} y2={y0 + rows.length * (rowH + gap) - 12} stroke={line} stroke-width="1.5" stroke-dasharray="3 5" />
        <text x={x(val)} y={y0 - 24} font-family="IBM Plex Mono, monospace" font-size="15" font-weight="600" fill={gray} text-anchor="middle">
          {val}
        </text>
      </g>
    ))}
  </g>

  <!-- Rows -->
  {rows.map((r, i) => {
    const y = y0 + i * (rowH + gap);
    const barW = Math.max(x(r.ppl) - x0, 8);
    return (
      <g>
        <line x1="60" y1={y + rowH + 6} x2={x1 + 40} y2={y + rowH + 6} stroke={line} stroke-width="1" opacity="0.6" />
        <text x="60" y={y + rowH - 16} font-family="Newsreader Variable, Georgia, serif" font-size="21" font-weight="500" fill={ink}>
          {r.name}
        </text>
        <rect x={x0} y={y + 4} width={barW} height={rowH - 12} rx="6" fill={r.color} opacity={r.dim ? 0.75 : 1} />
        <text x={x0 + barW + 14} y={y + rowH - 14} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink}>
          {r.ppl.toFixed(2)}
        </text>
      </g>
    );
  })}
</svg>