---
const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const gray = '#8a8377';

// bits (log2 domain 1.25..16) vs relative quality
const x0 = 190;
const x1 = 980;
const y0 = 450;
const y1 = 150;

const l2 = (v: number) => Math.log2(v);
const x = (v: number) => x0 + ((l2(v) - l2(1.25)) / (l2(16) - l2(1.25))) * (x1 - x0);
const q = (bits: number) => 1 - 0.42 * Math.exp(-l2(bits) / 3.6);
const y = (v: number) => y1 + (1 - v) * (y0 - y1);

const bitsRange = [1.58, 2, 4, 8, 16];

const curve = Array.from({ length: 200 }, (_, i) => {
  const b = 1.25 * Math.pow(16 / 1.25, i / 199);
  return `${i === 0 ? 'M' : 'L'} ${x(b).toFixed(1)} ${y(q(b)).toFixed(1)}`;
}).join(' ');
---

<svg
  viewBox="0 0 1200 560"
  role="img"
  aria-label="Curve of relative model quality versus bits per weight, with ternary and two-bit points marked"
  xmlns="http://www.w3.org/2000/svg"
  style="width:100%; height:auto; display:block;"
>
  <rect width="1200" height="560" fill={paper} />

  <!-- Top Title & Subtitle (Large & Bold) -->
  <text x="60" y="52" font-family="IBM Plex Mono, monospace" font-size="22" font-weight="700" letter-spacing="3" fill={ink}>
    QUALITY VS BITS PER WEIGHT
  </text>
  <text x="60" y="84" font-family="IBM Plex Mono, monospace" font-size="16" font-weight="500" letter-spacing="1.5" fill={gray}>
    ILLUSTRATIVE FRONTIER · NOT A SINGLE CONTROLLED RUN
  </text>

  <!-- Low-bit plateau shade & label -->
  <rect x={x0} y={y1} width={x(3.4) - x0} height={y0 - y1} fill={accent} opacity="0.07" rx="6" />
  <text x={(x0 + x(3.4)) / 2} y={y1 - 16} font-family="IBM Plex Mono, monospace" font-size="16" font-weight="700" letter-spacing="2" fill={accent} text-anchor="middle">
    LOW-BIT PLATEAU
  </text>

  <!-- Axes -->
  <line x1={x0} y1={y0} x2={x1 + 40} y2={y0} stroke={ink} stroke-width="3.5" />
  <line x1={x0} y1={y0} x2={x0} y2={y1 - 24} stroke={ink} stroke-width="3.5" />

  <!-- X ticks and labels -->
  {bitsRange.map((b) => (
    <g>
      <line x1={x(b)} y1={y0} x2={x(b)} y2={y0 + 8} stroke={ink} stroke-width="3" />
      <text x={x(b)} y={y0 + 34} font-family="IBM Plex Mono, monospace" font-size="18" font-weight="700" fill={ink} text-anchor="middle">
        {b}
      </text>
    </g>
  ))}

  <!-- X axis label -->
  <text x={x1 + 55} y={y0 + 34} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="600" fill={gray} text-anchor="start">
    bits/weight →
  </text>

  <!-- Y axis label -->
  <text x={x0} y={y1 - 32} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="600" fill={ink} text-anchor="middle">
    quality ↑
  </text>

  <!-- Curve line -->
  <path d={curve} fill="none" stroke={ink} stroke-width="3.5" opacity="0.9" />

  <!-- Point markers & Labels -->
  <g>
    <!-- FP16 Point -->
    <circle cx={x(16)} cy={y(q(16))} r="9" fill={ink} />
    <text x={x(16) - 16} y={y(q(16)) - 18} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="700" fill={ink} text-anchor="end">
      FP16 · 16 bits
    </text>

    <!-- Intermediate Points -->
    <circle cx={x(8)} cy={y(q(8))} r="6" fill={gray} />
    <circle cx={x(4)} cy={y(q(4))} r="6" fill={gray} />

    <!-- 2-Bit Quaternary Point -->
    <circle cx={x(2)} cy={y(q(2))} r="9" fill={teal} />
    <text x={x(2) + 16} y={y(q(2)) + 26} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="700" fill={teal} text-anchor="start">
      2 · FOUR STATES
    </text>

    <!-- 1.58-Bit Ternary Point -->
    <circle cx={x(1.58)} cy={y(q(1.58))} r="9" fill={accent} />
    <text x={x(1.58) - 16} y={y(q(1.58)) - 18} font-family="IBM Plex Mono, monospace" font-size="17" font-weight="700" fill={accent} text-anchor="end">
      1.58 · THREE STATES
    </text>
  </g>
</svg>