---
interface Props {
  card?: boolean;
}

const { card = false } = Astro.props;

const ink = '#1d1a15';
const paper = '#faf8f3';
const accent = '#b4522a';
const teal = '#2c6e66';
const line = '#cfc8b8';
const faint = '#8a8377';

const cx = 372;
const cy = 300;
const R = 172;
const r = 118;

const angles = [-90, 30, 150];

function pt(cx: number, cy: number, rad: number, deg: number): [number, number] {
  const a = (deg * Math.PI) / 180;
  return [cx + rad * Math.cos(a), cy + rad * Math.sin(a)];
}
---

<svg
  viewBox="0 0 1200 675"
  role="img"
  aria-label="Three-state ternary digit showing 1.58 bits per weight"
  xmlns="http://www.w3.org/2000/svg"
>
  <rect width="1200" height="675" fill={paper} />

  <!-- dot lattice -->
  <g fill={line} opacity="0.5">
    {Array.from({ length: 17 }).map((_, i) =>
      Array.from({ length: 10 }).map((_, j) => (
        <circle cx={38 + i * 70} cy={38 + j * 66} r="1.3" />
      )),
    )}
  </g>

  <text x="80" y="96" font-family="IBM Plex Mono, monospace" font-size="15" letter-spacing="4" fill={ink}>
    ONE TRIT · THREE STATES
  </text>
  {!card && (
    <text x="80" y="122" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="2" fill={faint}>
      LOG₂ 3 ≈ 1.585 BITS
    </text>
  )}

  <!-- trit dial -->
  <g>
    {angles.map((a) => (
      <path
        d={(() => {
          const [x1, y1] = pt(cx, cy, r, a - 46);
          const [x2, y2] = pt(cx, cy, r, a + 46);
          return `M ${x1} ${y1} A ${r} ${r} 0 0 1 ${x2} ${y2}`;
        })()}
        stroke={a === 150 ? accent : a === 30 ? teal : ink}
        stroke-width="26"
        stroke-linecap="round"
        fill="none"
        opacity="0.9"
      />
    ))}
    {angles.map((a) => {
      const [x, y] = pt(cx, cy, R, a);
      const label = a === -90 ? '+1' : a === 30 ? '0' : '−1';
      return (
        <g>
          <circle cx={x} cy={y} r="9" fill={a === 150 ? accent : a === 30 ? teal : ink} />
          <text x={x} y={y + (a === 30 ? 34 : -22)} font-family="IBM Plex Mono, monospace" font-size="17" fill={ink} text-anchor="middle">
            {label}
          </text>
        </g>
      );
    })}
    <text x={cx} y={cy - 8} font-family="Newsreader Variable, Georgia, serif" font-size="30" fill={ink} text-anchor="middle" font-style="italic">
      d
    </text>
    <text x={cx} y={cy + 24} font-family="IBM Plex Mono, monospace" font-size="12" letter-spacing="1" fill={faint} text-anchor="middle">
      ln(3)/ln(2)
    </text>
  </g>

  <!-- 1.58 numeral -->
  <g>
    <text x="640" y="330" font-family="Newsreader Variable, Georgia, serif" font-size="210" font-weight="550" fill={ink}>
      1.58
    </text>
    <text x="652" y="392" font-family="IBM Plex Mono, monospace" font-size="16" letter-spacing="3" fill={faint}>
      BITS PER WEIGHT
    </text>
    {!card && (
      <text x="652" y="424" font-family="IBM Plex Mono, monospace" font-size="14" letter-spacing="1" fill={faint}>
      THREE SYMBOLS · {`{−1, 0, +1}`} · ONE SYMBOL ≈ 0.53 BITS
      </text>
    )}
  </g>

  <!-- storage bar -->
  <g>
    <line x1="640" y1="520" x2="1120" y2="520" stroke={line} stroke-width="1.5" />
    <rect x="640" y="486" width="470" height="16" rx="4" fill="none" stroke={ink} stroke-width="2" />
    <rect x="640" y="486" width="470" height="16" rx="4" fill={ink} opacity="0.07" />
    {!card && (
      <text x="640" y="570" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="1" fill={faint}>
        FP16 WEIGHTS: 16 BITS
      </text>
    )}
    <rect x="640" y="600" width="470" height="16" rx="4" fill="none" stroke={accent} stroke-width="2" />
    <rect x="640" y="600" width={Math.round((1.585 / 16) * 470)} height="16" rx="4" fill={accent} />
    {!card && (
      <text x="640" y="648" font-family="IBM Plex Mono, monospace" font-size="13" letter-spacing="1" fill={faint}>
        TERNARY: 1.58 BITS — ~10× FEWER WEIGHT BYTES
      </text>
    )}
  </g>
</svg>
