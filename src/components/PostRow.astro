---
import type { Post } from '../lib/posts';
import { fmtDate, postUrl } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<a href={postUrl(post)} class="post-row">
  <span class="row-date">{fmtDate(post.data.date)}</span>
  <div class="row-tag">
    <span class:list={['type-tag', post.data.type]}>
      {post.data.type === 'research' ? 'Research' : 'Blog'}
    </span>
  </div>
  <h3>{post.data.title}</h3>
  <span class="row-arrow">→</span>
</a>