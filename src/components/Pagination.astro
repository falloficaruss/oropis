---
interface Props {
  page: number;
  total: number;
  prevUrl?: string;
  nextUrl?: string;
}

const { page, total, prevUrl, nextUrl } = Astro.props;
---

<nav class="pagination" aria-label="Pagination">
  {prevUrl ? <a href={prevUrl} rel="prev">&larr; Newer</a> : <span class="disabled">&larr; Newer</span>}
  <span class="page-count">Page {page} of {total}</span>
  {nextUrl ? <a href={nextUrl} rel="next">Older &rarr;</a> : <span class="disabled">Older &rarr;</span>}
</nav>
