---
interface Source {
  name: string;
  url: string;
  publisher?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
const label = (name: string) =>
  name
    .replace(/_/g, ' ')
    .replace(/\b\w/g, (c) => c.toUpperCase());
---

{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-title">
    <h2 id="sources-title">Sources</h2>
    <ol>
      {sources.map((source) => (
        <li>
          <a href={source.url} rel="noopener nofollow" target="_blank">{label(source.name)}</a>
          {source.publisher && <span class="source-publisher">{source.publisher}</span>}
        </li>
      ))}
    </ol>
    <p class="sources-note">Oropis verifies the underlying facts independently. Linked sources may include primary records, official statements, or public data.</p>
  </section>
)}
