---
import '@fontsource-variable/inter';
import '@fontsource-variable/newsreader';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  updated?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Oropis covers PUBG Mobile and BGMI, Free Fire, and Call of Duty: Mobile with original reporting, results, roster moves, patches, and the business of mobile esports.',
  image = '/og-default.png',
  type = 'website',
  published,
  updated,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteName = 'Oropis';
const fullTitle = title ? `${title} — Oropis` : `${siteName} — Mobile esports, reported`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const current = Astro.url.pathname.replace(/\/+$/, '') || '/';

const nav = [
  { href: '/news/', label: 'Latest' },
  { href: '/results/', label: 'Results' },
  { href: '/transfers/', label: 'Roster moves' },
  { href: '/patches/', label: 'Patches' },
  { href: '/business/', label: 'Business' },
  { href: '/games/', label: 'Games' },
];

const isActive = (href: string) => current === href.replace(/\/+$/, '') || current.startsWith(href.replace(/\/+$/, '') + '/');

const structured = jsonLd
  ? Array.isArray(jsonLd)
    ? jsonLd
    : [jsonLd]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href="/rss.xml" />
    <meta name="theme-color" content="#0b0d10" />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@OropisHQ" />
    <meta name="twitter:creator" content="@OropisHQ" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {structured.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="site-head">
      <div class="wrap head-row">
        <a class="brand" href="/" aria-label="Oropis Mobile Esports home">
          <span class="brand-mark" aria-hidden="true">O</span>
          <span class="brand-text">
            <strong>Oropis</strong>
            <small>Mobile Esports</small>
          </span>
        </a>

        <nav class="nav" aria-label="Sections">
          {nav.map((item) => (
            <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
          ))}
        </nav>

        <div class="head-actions">
          <a class="search-link" href="/search/" aria-label="Search">Search</a>
          <a class="x-link" href="https://x.com/OropisHQ" rel="me noopener" target="_blank" aria-label="OropisHQ on X">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M18.9 2H22l-6.8 7.8L23 22h-6.3l-4.9-6.5L6.2 22H3l7.3-8.4L2 2h6.4l4.4 5.9L18.9 2Zm-1.1 18h1.7L7.9 3.8H6.1L17.8 20Z"/></svg>
            <span>@OropisHQ</span>
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-grid">
        <div class="foot-brand">
          <a class="brand" href="/">
            <span class="brand-mark" aria-hidden="true">O</span>
            <span class="brand-text"><strong>Oropis</strong><small>Mobile Esports</small></span>
          </a>
          <p>Independent mobile-esports coverage for PUBG Mobile and BGMI, Free Fire, and Call of Duty: Mobile. Reported, edited, and published by OropisHQ.</p>
        </div>
        <div class="foot-col">
          <h2>Sections</h2>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </div>
        <div class="foot-col">
          <h2>Oropis</h2>
          <a href="/about/">About</a>
          <a href="/contact/">Contact</a>
          <a href="/corrections/">Corrections</a>
          <a href="/rss.xml">RSS feed</a>
        </div>
        <div class="foot-col">
          <h2>Legal</h2>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="https://x.com/OropisHQ" rel="me noopener" target="_blank">X / Twitter</a>
        </div>
      </div>
      <div class="wrap foot-bottom">
        <span>&copy; {new Date().getFullYear()} Oropis</span>
        <span>Built for the people who watch the replay.</span>
      </div>
    </footer>
  </body>
</html>
