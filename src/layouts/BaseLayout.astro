---
import '../styles/global.css';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

interface Props {
  title: string;
  description?: string;
  active?: string;
}

const { title, description = 'Research and writing on small language models, hardware arithmetic, and efficient inference.', active } = Astro.props;

const year = new Date().getFullYear();

const navItems = [
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} — Oropis Research</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header__wrap">
        <a class="brand-group" href="/">
          <span class="wordmark">Oropis</span>
          <span class="wordmark-tag">Research</span>
        </a>
        <nav class="main-nav">
          {navItems.map((item) => (
            <a href={item.href} class:list={[{ active: active === item.href }]}>
              {item.label}
            </a>
          ))}
          <a href="https://github.com/falloficaruss/oropis" target="_blank" rel="noopener" class="nav-cta">
            View Code <span style="font-size:1.05em">↗</span>
          </a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="site-footer__grid">
          <div class="footer-brand">
            <span class="wordmark">Oropis</span>
            <p>
              An independent research lab investigating efficient inference, low-bit arithmetic, and hardware-aligned language models.
            </p>
          </div>

          <div class="footer-col">
            <h4>Research</h4>
            <ul>
              <li><a href="/posts/tetranet">TetraNet Paper</a></li>
              <li><a href="/posts/era-of-1-bit-llms">1-bit LLMs &amp; Kernels</a></li>
              <li><a href="/research">All Publications</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Topics</h4>
            <ul>
              <li><a href="/research">Quantization Grids</a></li>
              <li><a href="/research">Shift-Oriented Kernels</a></li>
              <li><a href="/research">Energy Sensitivity Modeling</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h4>Connect</h4>
            <ul>
              <li><a href="https://github.com/falloficaruss" target="_blank" rel="noopener">GitHub</a></li>
              <li><a href="https://x.com/falloficarus22" target="_blank" rel="noopener">X / Twitter</a></li>
              <li><a href="/rss.xml">RSS Feed</a></li>
              <li><a href="mailto:norizzabhii@gmail.com">Contact Email</a></li>
            </ul>
          </div>
        </div>

        <div class="site-footer__bottom">
          <span>© {year} Oropis Research — Small weights, sharp ideas.</span>
          <div style="display:flex; gap:20px;">
            <a href="/rss.xml">RSS</a>
            <a href="https://github.com/falloficaruss/oropis" target="_blank" rel="noopener">Open Source</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
