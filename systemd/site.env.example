# Oropis site admin credentials. Install at ~/.config/agg/site.env with mode 600.
# Generate secrets with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
SITE_ADMIN_USER=oropis
SITE_ADMIN_PASSWORD=replace-with-a-long-password
SITE_SECRET_KEY=replace-with-a-long-random-string
# AGG_ACCOUNT=oropis
