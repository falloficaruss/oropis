[Unit]
Description=agg site admin (%i)
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/twitter/%i
EnvironmentFile=%h/.config/agg/site.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=%h/twitter/.venv/bin/python -m agg -a %h/twitter/%i site serve
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
