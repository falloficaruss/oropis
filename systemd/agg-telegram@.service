[Unit]
Description=agg Telegram news bot (%i)
After=network-online.target agg@%i.service
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/twitter/%i
EnvironmentFile=%h/.config/agg/telegram.env
ExecStart=%h/twitter/.venv/bin/python -m agg -a %h/twitter/%i bot
Restart=on-failure
RestartSec=15
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
