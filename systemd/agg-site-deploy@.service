[Unit]
Description=agg site export, build, and deploy (%i)
After=network-online.target agg@%i.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/twitter/%i
EnvironmentFile=%h/.config/agg/site.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/twitter/.venv/bin/python -m agg -a %h/twitter/%i site deploy --if-dirty
Nice=10
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal
