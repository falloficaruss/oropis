[Unit]
Description=agg feed aggregator (%i)
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
Type=simple
WorkingDirectory=%h/twitter/%i
ExecStart=%h/twitter/.venv/bin/python -m agg -a %h/twitter/%i run
Restart=on-failure
RestartSec=20
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
